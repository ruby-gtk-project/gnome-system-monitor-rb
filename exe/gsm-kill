#!/usr/bin/env ruby
# frozen_string_literal: true

# Privileged half of "End Process" and friends, run under pkexec when the
# process belongs to another user. Upstream ships the same helper as a small C
# binary; the polkit action that authorises it is unchanged.
#
# Usage: gsm-kill -s SIGNAL PID

if ARGV.length != 3 || ARGV[0] != "-s"
  warn("usage: gsm-kill -s SIGNAL PID")
  exit(2)
end

begin
  Process.kill(Integer(ARGV[1]), Integer(ARGV[2]))
rescue StandardError => e
  warn("gsm-kill: #{e.message}")
  exit(1)
end
